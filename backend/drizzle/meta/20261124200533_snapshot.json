      "checkConstraints": {
        "ck_users_username": {
          "name": "ck_users_username",
          "value": "length(\"users\".\"username\") BETWEEN 3 AND 30\n        AND lower(\"users\".\"username\") NOT GLOB '*[^a-z0-9_]*'\n        AND \"users\".\"username\" GLOB '*[a-zA-Z]*'\n        AND (\"users\".\"deleted_at\" IS NOT NULL\n          OR lower(\"users\".\"username\") NOT GLOB 'deleted_user_*')"
        },
        "ck_users_email": {
          "name": "ck_users_email",
          "value": "\"users\".\"email\" IS NULL OR (\"users\".\"email\" = lower(\"users\".\"email\")\n        AND length(\"users\".\"email\") BETWEEN 6 AND 254\n        AND \"users\".\"email\" LIKE '%_@_%._%'\n        AND NOT \"users\".\"email\" GLOB '*@*@*'\n        AND NOT \"users\".\"email\" GLOB '* *')"
        },
        "ck_users_phone": {
          "name": "ck_users_phone",
          "value": "\"users\".\"phone\" IS NULL OR (\"users\".\"phone\" GLOB '+[0-9]*'\n        AND NOT substr(\"users\".\"phone\", 2) GLOB '*[^0-9]*'\n        AND length(\"users\".\"phone\") BETWEEN 8 AND 16)"
        },
        "ck_users_contact": {
          "name": "ck_users_contact",
          "value": "\"users\".\"deleted_at\" IS NOT NULL OR \"users\".\"email\" IS NOT NULL"
        },
        "ck_users_bio": {
          "name": "ck_users_bio",
          "value": "\"users\".\"bio\" IS NULL OR length(\"users\".\"bio\") BETWEEN 1 AND 500"
        },
        "ck_users_avatar_path": {
          "name": "ck_users_avatar_path",
          "value": "\"users\".\"avatar_path\" IS NULL OR length(\"users\".\"avatar_path\") BETWEEN 1 AND 512"
        },
        "ck_users_role": {
          "name": "ck_users_role",
          "value": "\"users\".\"role\" IN ('user', 'moderator', 'admin')"
        },
        "ck_users_post_visibility": {
          "name": "ck_users_post_visibility",
          "value": "\"users\".\"post_visibility\" IN ('public', 'friends')"
        },
        "ck_users_group_invite_policy": {
          "name": "ck_users_group_invite_policy",
          "value": "\"users\".\"group_invite_policy\" IN ('public', 'friends')"
        },
