{
  "name": "2stagram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11 <13"
  },
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "setup": "node scripts/setup.ts",
    "prepare": "node scripts/prepare-hooks.ts",
    "start": "docker compose up --build",
    "stop": "docker compose down",
    "dev": "npm run build:shared && node scripts/dev.ts",
    "dev:backend": "npm run build:shared && npm run dev -w @2stagram/backend",
    "dev:frontend": "npm run build:shared && npm run dev -w @2stagram/frontend",
    "build": "npm run build:shared && npm run build -w @2stagram/frontend",
    "build:shared": "npm run build -w @2stagram/shared",
    "typecheck": "npm run build:shared && npm run typecheck --workspaces && tsc -p tsconfig.tools.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "test": "npm run build:shared && vitest run",
    "test:watch": "npm run build:shared && vitest",
    "test:coverage": "npm run build:shared && vitest run --coverage",
    "test:cov": "npm run test:coverage",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --config playwright.smoke.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "audit:dependencies": "node scripts/audit.ts",
    "sbom": "npm sbom --sbom-format cyclonedx",
    "docs:api": "npm run build:shared && typedoc",
    "docs:site": "npm run docs:api && node scripts/sync-docs.ts && npm run build --prefix docs-site",
    "docs:dev": "npm run start --prefix docs-site",
    "audit:docs": "node scripts/audit-docs.ts",
    "audit:docs:strict": "node scripts/audit.ts --prefix docs-site"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-security": "4.0.1",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "17.5.0",
    "prettier": "3.9.6",
    "typedoc": "0.28.20",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "better-sqlite3@13.0.3": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@scarf/scarf": false
  }
}
