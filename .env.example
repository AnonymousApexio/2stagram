# Copier ce fichier en .env et remplir les valeurs. Le .env n'est jamais commité.

NODE_ENV=development
PORT=3000
HOST=127.0.0.1
WEB_PORT=8080

# Session : chaîne aléatoire longue, différente par environnement
SESSION_SECRET=changeme

# Volumes
DATABASE_PATH=./db/2stagram.db
MEDIA_PATH=./media

# Limite d'upload, à garder alignée avec client_max_body_size côté nginx
MAX_UPLOAD_SIZE_MB=25
